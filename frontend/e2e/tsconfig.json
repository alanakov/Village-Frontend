{
  "compilerOptions": {
    "target":      "ES2022",
    "module":      "commonjs",
    "lib":         ["ES2022", "DOM"],
    "types":       ["node", "@playwright/test"],
    "strict":      true,
    "esModuleInterop": true,
    "skipLibCheck":    true,
    "resolveJsonModule": true,
    "outDir":      "./dist",
    "rootDir":     ".",
    "ignoreDeprecations": "6.0",
    "baseUrl":     ".",
    "paths": {
      "@data/*":    ["./data/*"],
      "@fixtures/*":["./fixtures/*"],
      "@helpers/*": ["./helpers/*"],
      "@pages/*":   ["./pages/*"],
      "@utils/*":   ["./utils/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist", "playwright-report"]
}
